# Copy this file to .env and fill in real values before Step 3 (deployment).
# NEVER commit the real .env file — it is already covered by .gitignore.

# Sepolia RPC endpoint (e.g. from Alchemy: https://eth-sepolia.g.alchemy.com/v2/<key>)
SEPOLIA_RPC_URL=

# Private key of the deployer/admin account, WITH the 0x prefix (e.g. 0xabc123...).
# Use a dedicated Sepolia test wallet funded only with test ETH — never a real/mainnet key.
PRIVATE_KEY=

# Etherscan API key, used by `npx hardhat verify` to verify the deployed source code.
ETHERSCAN_API_KEY=
